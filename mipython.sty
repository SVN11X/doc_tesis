\NeedsTeXFormat{LaTeX2e}            % Indicar que el archivo esta en formato de LaTeX2e y para evitar problemas de compatibilidad con otras versiones.
\ProvidesPackage{mipython}          % Indicar el nombre del paquete y su versión, y para evitar que el archivo sea cargado varias veces.

\usepackage{listings}
\usepackage{mdframed}

\definecolor{dark-foreground}{HTML}{1E1E1E}
\definecolor{dark-red}{HTML}{9D0023}
\definecolor{dark-green}{HTML}{008F00}
\definecolor{dark-yellow}{HTML}{FABD2F}
\definecolor{dark-blue}{HTML}{1C00CF}
\definecolor{dark-magenta}{HTML}{8F0095}
\definecolor{dark-cyan}{HTML}{00AEB3}

\definecolor{code-background}{HTML}{F0F0F0}
\definecolor{code-border}{HTML}{D0D0D0}

\mdfdefinestyle{code-frame}{
  backgroundcolor=code-background,
  roundcorner=4pt,
  leftline=false,
  rightline=false,
  topline=false,
  bottomline=false,
  linewidth=0pt,
  innerleftmargin=10pt,
  innerrightmargin=10pt,
  innertopmargin=10pt,
  innerbottommargin=10pt,
  skipabove=5pt,
  skipbelow=5pt
}

\lstdefinestyle{mipython}{
  backgroundcolor=\color{code-background},
  basicstyle=\ttfamily\footnotesize\color{dark-foreground},
  breakatwhitespace=false,
  breaklines=true,
  captionpos=b,
  commentstyle=\color{dark-cyan},
  escapeinside={\%*}{*)},
  extendedchars=true,
  frame=none,
  keywordstyle=\color{dark-red},
  language=Python,
  morekeywords={as, assert, with},
  numbers=left,
  numbersep=5pt,
  numberstyle=\tiny\color{dark-foreground},
  rulecolor=\color{code-border},
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  stepnumber=1,
  stringstyle=\color{dark-yellow},
  tabsize=2,
  title=\lstname,
  emph={True, False, None},
  emphstyle=\color{dark-magenta}
}

\lstnewenvironment{code}[1][]{  % Define un nuevo entorno de listado (listing) llamado code 
  \mdframed[style=code-frame]   % Crea un marco decorativo con el estilo de code-frame 
  \lstset{style=mipython, #1}   % Establece el estilo de listado de mipython, #1 indica que cualquier opción adicional pasada al entorno se pasará al comando \lstset.
}{\endmdframed}                 % Cierra el marco decorativo
