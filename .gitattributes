* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.glb binary
*.stl binary
*.step binary
*.parquet binary

# Files over 5 MB go to Git LFS.
docs/defense/*.pptx filter=lfs diff=lfs merge=lfs -text
docs/defense/images/*.png filter=lfs diff=lfs merge=lfs -text
docs/submitted/*.pdf filter=lfs diff=lfs merge=lfs -text

# Keep the line endings of the thesis sources as git already checks them out on this computer.
*.tex text !eol
*.bib text !eol
